# ---- Required ----
DISCORD_TOKEN=            # Bot token (Developer Portal > Bot). Secret.
DISCORD_CLIENT_ID=        # Application ID
GUILD_ID=                 # Your Nexora Hub server ID

# ---- Storage (Railway: attach a Volume at /data) ----
DATA_DIR=/data
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28

# ---- Channels / categories (IDs) ----
DEAL_CATEGORY_ID=
DISPUTE_CATEGORY_ID=
TICKET_CATEGORY_ID=
COMPLETED_CHANNEL_ID=1573311101159084213
VOUCH_CHANNEL_ID=
STAFF_LOG_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=1573328871917621409
PANEL_CHANNEL_ID=1573311773996482570   # /panel posts the Start-a-deal panel here

# ---- Fees / release ----
FEE_THRESHOLD_USD=50      # deals over this amount pay the flat FEE_USD
FEE_USD=2
FEE_PERCENT_OVER_USD=250  # deals over this amount pay FEE_PERCENT % instead
FEE_PERCENT=2
RELEASE_DELAY_SEC=60

# ---- Staff roles (comma-separated role IDs) ----
ROLE_OWNER_IDS=
ROLE_ADMIN_IDS=
ROLE_SENIOR_MIDDLEMAN_IDS=
ROLE_MIDDLEMAN_IDS=
ROLE_SUPPORT_IDS=
ROLE_TRIAL_IDS=

# ---- Mode: demo (default) or live ----
NEXORA_MODE=demo
# Demo mode: secret used to verify signed webhooks sent to /webhooks/provider
DEMO_WEBHOOK_SECRET=
# Live mode (do NOT set until the provider, operator and legal checks are done; see README):
# NEXORA_MODE=live
# LIVE_MODE_ACK=I_ACCEPT_SELF_CUSTODY_RISK_OF_HOLDING_USER_FUNDS
# LTC_NETWORK=testnet   # mainnet only after a full testnet run
# LTC_MNEMONIC=         # optional; otherwise generated on the data volume, read with /staff wallet
# LTC_TREASURY_ADDRESS= # optional fee address
# LTC_API_URL=         # optional Esplora-compatible API base (default litecoinspace.org)
# LTC_CONFIRMATIONS=2
# LTC_MAX_DEAL_USD=100

BRAND_LOGO_URL=           # optional
# PORT is set by Railway
# Optional: extra Discord user IDs treated as Owner (guild owner and Administrators are detected automatically)
OWNER_USER_IDS=

# --- Multi-coin (live mode) ---
# Coins shown on the panel. Enable one at a time, after a small real deal worked:
# LTC,ETH,USDT-ERC20,USDC-ERC20,USDT-BEP20,SOL
ENABLED_COINS=LTC
MAX_DEAL_USD=3
# Optional overrides (defaults derive from the shared recovery phrase / public RPCs)
EVM_TREASURY_ADDRESS=
SOL_TREASURY_ADDRESS=
ETH_RPC_URL=
BSC_RPC_URL=
SOL_RPC_URL=
ETH_CONFIRMATIONS=6
BSC_CONFIRMATIONS=15
SUPPORT_PANEL_CHANNEL_ID=1573311847468240997   # /supportpanel posts the support panel here
STATS_CHANNEL_ID=1573311516122284042   # /stats only works here
RULES_CHANNEL_ID=1573310737810718760   # /rules posts the rules here
WELCOME_CHANNEL_ID=1573651215911227585   # new members are welcomed here (needs Server Members intent)

# Text commands: type .help in the server. Slash commands are removed unless SLASH_COMMANDS=1.
# COMMAND_PREFIX=.
# SLASH_COMMANDS=0

# Activity tracking: messages are counted per member; the server tag and a custom status containing this text are tracked.
# Needs the Presence Intent (Developer Portal) for the status; the tag only needs the Server Members intent.
# STATUS_PHRASE=.gg/nexorra

# Status rewards (.status panel). Payouts are paid by staff by hand.
FEES_CHANNEL_ID=
STATUS_PANEL_CHANNEL_ID=
STATUS_PAYOUT_CHANNEL_ID=
STATUS_PAY_DAILY=0.20
STATUS_PAY_WEEK_BONUS=1.20
STATUS_MIN_PAYOUT=0.20
STATUS_ROLE_ID=1574324490236596314
